# SAP B1
SAP_BASE_URL=https://cl-cloud-sl1.sapparapymes.cloud:50000/b1s/v1
SAP_COMPANY_DB=CLTSTADQUIM  # usar test por defecto
# Validar cert TLS de SAP. True por defecto (producción cloud).
# On-prem con cert autofirmado: dejar True y configurar SAP_CA_BUNDLE.
SAP_VERIFY_SSL=True
# Path al bundle CA para SAP on-prem (ej. /certs/sap-ca.pem). Vacío = store del SO.
SAP_CA_BUNDLE=

# Service account (cuenta dedicada para la plataforma)
SAP_SERVICE_USER=plataforma_svc
SAP_SERVICE_PASSWORD=tu-password-aqui

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://usr:psw@host:port/adquim_db

# JWT
JWT_SECRET_KEY=cambia-esto-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS — orígenes permitidos (CSV). En prod: el dominio de Static Web Apps.
ALLOWED_ORIGINS=http://localhost:5173